<!--
  Reverse X · สไตล์ Millennium 3D / Frutiger Aero (สไตล์อย่างเดียว ไม่มีสีที่ขึ้นกับธีม)
  สีที่เปลี่ยนตามธีมมาจาก Palette.*.xaml ผ่าน DynamicResource เท่านั้น — ห้ามใช้ StaticResource กับ B.* ที่อยู่ใน palette
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:tools="clr-namespace:ReverseX.Core.Tools;assembly=ReverseX.Core">

    <!-- ===================================================== ฟอนต์ (OFL ฝังในแอป) -->
    <FontFamily x:Key="F.Ui">/ReverseX;component/Assets/Fonts/#Anuphan, Segoe UI, Leelawadee UI</FontFamily>
    <FontFamily x:Key="F.Head">/ReverseX;component/Assets/Fonts/#Kanit, Leelawadee UI</FontFamily>
    <FontFamily x:Key="F.Num">/ReverseX;component/Assets/Fonts/#Kanit, Bahnschrift</FontFamily>
    <FontFamily x:Key="F.Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="F.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- ===================================================== แปรงที่ไม่ขึ้นกับธีม -->
    <LinearGradientBrush x:Key="B.BtnGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A6FFFFFF" Offset="0"/>
        <GradientStop Color="#33FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Chrome" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FDFEFE" Offset="0"/>
        <GradientStop Color="#C9D4DF" Offset="0.22"/>
        <GradientStop Color="#7D8997" Offset="0.5"/>
        <GradientStop Color="#DDE5EC" Offset="0.72"/>
        <GradientStop Color="#8F9CAA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.GoldRing" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C9932E" Offset="0"/>
        <GradientStop Color="#FFF1C4" Offset="0.5"/>
        <GradientStop Color="#C9932E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.AquaGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D4FCFF" Offset="0"/>
        <GradientStop Color="#6EE6F8" Offset="0.47"/>
        <GradientStop Color="#18AEDB" Offset="0.53"/>
        <GradientStop Color="#3CCFF0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B.AquaText" Color="#03263B"/>
    <LinearGradientBrush x:Key="B.VioletGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E4D9FF" Offset="0"/>
        <GradientStop Color="#A58BFF" Offset="0.47"/>
        <GradientStop Color="#6A3BDB" Offset="0.53"/>
        <GradientStop Color="#8B63F5" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B.VioletBtnText" Color="#FFFFFF"/>
    <LinearGradientBrush x:Key="B.RedGloss" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFB3B9" Offset="0"/>
        <GradientStop Color="#FF5B6B" Offset="0.48"/>
        <GradientStop Color="#D9213A" Offset="0.52"/>
        <GradientStop Color="#F0435A" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="E.Card" BlurRadius="20" ShadowDepth="5" Direction="270" Color="#000814" Opacity="0.30"/>
    <DropShadowEffect x:Key="E.Icon" BlurRadius="8" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.35"/>

    <!-- ===================================================== ข้อความ -->
    <Style x:Key="T.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Head}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="Effect" Value="{DynamicResource E.Title}"/>
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Head}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="T.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="T.Sub" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text3}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="T.Num" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Num}"/>
        <Setter Property="FontSize" Value="38"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource B.NumText}"/>
        <Setter Property="Effect" Value="{DynamicResource E.Num}"/>
    </Style>
    <Style x:Key="T.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Mono}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
    </Style>
    <Style x:Key="T.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icon}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Icon3D" TargetType="Image">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
        <Setter Property="Effect" Value="{StaticResource E.Icon}"/>
    </Style>

    <!-- ===================================================== การ์ดกระจก: 3 ชั้น + gloss ด้านบน + เส้นขอบสว่าง -->
    <ControlTemplate x:Key="T.Glass" TargetType="ContentControl">
        <Grid>
            <Border x:Name="Base" CornerRadius="18" Background="{DynamicResource B.CardGrad}"
                    BorderBrush="{DynamicResource B.GlassLine}" BorderThickness="1.2" Effect="{StaticResource E.Card}"/>
            <Border Margin="1.5" CornerRadius="16.5" Background="{DynamicResource B.Gloss}" IsHitTestVisible="False"/>
            <Border Margin="1.2" CornerRadius="16.8" BorderBrush="{DynamicResource B.InnerLine}" BorderThickness="1" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
        </Grid>
    </ControlTemplate>
    <Style x:Key="GlassCard" TargetType="ContentControl">
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{StaticResource T.Glass}"/>
    </Style>

    <!-- กรอบโครเมียมรอบการ์ดเด่น (ฮีโร่) -->
    <ControlTemplate x:Key="T.ChromeGlass" TargetType="ContentControl">
        <Grid>
            <Border CornerRadius="22" Background="{DynamicResource B.CardGrad}"
                    BorderBrush="{StaticResource B.Chrome}" BorderThickness="2.5" Effect="{StaticResource E.Card}"/>
            <Border Margin="2.5" CornerRadius="19.5" Background="{DynamicResource B.Gloss}" IsHitTestVisible="False"/>
            <Border Margin="2.5" CornerRadius="19.5" BorderBrush="{DynamicResource B.InnerLine}" BorderThickness="1" IsHitTestVisible="False"/>
            <ContentPresenter Margin="{TemplateBinding Padding}"/>
        </Grid>
    </ControlTemplate>
    <Style x:Key="ChromeCard" TargetType="ContentControl">
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{StaticResource T.ChromeGlass}"/>
    </Style>
    <Style x:Key="ChromeFrame" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource B.Chrome}"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="14"/>
    </Style>

    <!-- ===================================================== ปุ่ม aqua / violet / ghost (วงทอง + gloss ครึ่งบน) -->
    <ControlTemplate x:Key="T.GlossButton" TargetType="Button">
        <Border x:Name="Ring" CornerRadius="16" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5"
                Background="{TemplateBinding Background}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="14.5,14.5,0,0" Background="{StaticResource B.BtnGloss}" Opacity="0.55" IsHitTestVisible="False"/>
                <Border x:Name="Hot" Grid.RowSpan="2" CornerRadius="14.5" Background="White" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                  TextElement.FontWeight="SemiBold"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hot" Property="Opacity" Value="0.22"/></Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Hot" Property="Opacity" Value="0.38"/>
                <Setter TargetName="Ring" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1"/></Setter.Value></Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Btn.Aqua" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource B.AquaGloss}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.GoldRing}"/>
        <Setter Property="Foreground" Value="{StaticResource B.AquaText}"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template" Value="{StaticResource T.GlossButton}"/>
    </Style>
    <Style x:Key="Btn.Violet" TargetType="Button" BasedOn="{StaticResource Btn.Aqua}">
        <Setter Property="Background" Value="{StaticResource B.VioletGloss}"/>
        <Setter Property="Foreground" Value="{StaticResource B.VioletBtnText}"/>
    </Style>
    <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn.Aqua}">
        <Setter Property="Background" Value="{DynamicResource B.GlassBtn}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.GlassLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.GlassBtnText}"/>
    </Style>

    <!-- ปุ่มหน้าต่าง (ย่อ/ขยาย/ปิด) และปุ่มไอคอนเล็ก -->
    <ControlTemplate x:Key="T.WinButton" TargetType="Button">
        <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource B.GlassLine}"
                Background="{TemplateBinding Background}">
            <Grid>
                <Border x:Name="Hot" CornerRadius="7" Background="White" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hot" Property="Opacity" Value="0.25"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Hot" Property="Opacity" Value="0.4"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Btn.Win" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="3,0,0,0"/>
        <Setter Property="FontFamily" Value="{StaticResource F.Icon}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Background" Value="{DynamicResource B.GlassBtn}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.GlassBtnText}"/>
        <Setter Property="Template" Value="{StaticResource T.WinButton}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="Btn.WinClose" TargetType="Button" BasedOn="{StaticResource Btn.Win}">
        <Setter Property="Background" Value="{StaticResource B.RedGloss}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="Btn.Mini" TargetType="Button" BasedOn="{StaticResource Btn.Win}">
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <!-- ===================================================== เมนูซ้ายแบบแคปซูล -->
    <ControlTemplate x:Key="T.Nav" TargetType="RadioButton">
        <Border x:Name="Pill" CornerRadius="15" BorderThickness="1.5" BorderBrush="Transparent" Background="Transparent"
                Height="42" Margin="0,2">
            <Grid Margin="8,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="28" Height="28"
                       Style="{StaticResource Icon3D}"/>
                <ContentPresenter x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                  TextElement.FontWeight="Medium"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource B.Hover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pill" Property="Background" Value="{StaticResource B.AquaGloss}"/>
                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource B.GoldRing}"/>
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource B.AquaText}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{StaticResource T.Nav}"/>
    </Style>

    <!-- สวิตช์สองช่อง (ธีม / ภาษา) -->
    <ControlTemplate x:Key="T.Seg" TargetType="RadioButton">
        <Border x:Name="Seg" CornerRadius="11" Padding="11,3" Background="Transparent" BorderThickness="0">
            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.FontWeight="Medium"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Seg" Property="Background" Value="{StaticResource B.AquaGloss}"/>
                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{StaticResource B.AquaText}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Seg" Property="Opacity" Value="0.85"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource B.GlassBtnText}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template" Value="{StaticResource T.Seg}"/>
    </Style>

    <!-- ===================================================== ชิป / ป้ายตัวเลข -->
    <ControlTemplate x:Key="T.Chip" TargetType="ContentControl">
        <Border CornerRadius="8" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </ControlTemplate>
    <Style x:Key="Chip" TargetType="ContentControl">
        <Setter Property="Padding" Value="9,2"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource B.GlassBtn}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.GlassBtnText}"/>
        <Setter Property="Template" Value="{StaticResource T.Chip}"/>
    </Style>
    <Style x:Key="Chip.Green" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource B.GreenSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.GreenSoftLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.GreenText}"/>
    </Style>
    <Style x:Key="Chip.Amber" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource B.AmberSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.AmberSoftLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.AmberText}"/>
    </Style>
    <Style x:Key="Chip.Red" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource B.RedSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.RedSoftLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.RedText}"/>
    </Style>
    <Style x:Key="Chip.Cyan" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource B.CyanSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.CyanSoftLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.CyanText}"/>
    </Style>
    <Style x:Key="Chip.Violet" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource B.VioletSoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.VioletSoftLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.VioletText}"/>
    </Style>
    <Style x:Key="Chip.Grey" TargetType="ContentControl" BasedOn="{StaticResource Chip}">
        <Setter Property="Background" Value="{DynamicResource B.GreySoft}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource B.GreySoftLine}"/>
        <Setter Property="Foreground" Value="{DynamicResource B.GreyText}"/>
    </Style>

    <ControlTemplate x:Key="T.Badge" TargetType="ContentControl">
        <Border CornerRadius="10" MinWidth="22" Height="20" Padding="6,0" Background="{StaticResource B.VioletGloss}"
                BorderBrush="{StaticResource B.GoldRing}" BorderThickness="1">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </ControlTemplate>
    <Style x:Key="Badge" TargetType="ContentControl">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource T.Badge}"/>
    </Style>

    <!-- ===================================================== ช่องค้นหา inset (ขอบในมืดด้านบน) -->
    <ControlTemplate x:Key="T.Search" TargetType="TextBox">
        <Border CornerRadius="14" Background="{DynamicResource B.Input}" BorderBrush="{DynamicResource B.InputLine}" BorderThickness="1">
            <Grid>
                <Border CornerRadius="13" Margin="0" BorderBrush="{DynamicResource B.InputShadow}" BorderThickness="0,2,0,0" IsHitTestVisible="False"/>
                <Grid Margin="10,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource T.Glyph}" Text="&#xE721;" FontSize="12" Margin="0,0,7,0"
                               Foreground="{DynamicResource B.Text3}"/>
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource B.Text3}" FontSize="12"
                                   VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="SearchBox" TargetType="TextBox">
        <Setter Property="Height" Value="28"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource B.Cyan}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource T.Search}"/>
    </Style>

    <!-- จุดสถานะ: ผูก Tag กับ ToolLevel -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="11"/>
        <Setter Property="Height" Value="11"/>
        <Setter Property="Fill" Value="{DynamicResource B.Grey}"/>
        <Setter Property="Stroke" Value="#80FFFFFF"/>
        <Setter Property="StrokeThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="{x:Static tools:ToolLevel.Ok}"><Setter Property="Fill" Value="{DynamicResource B.Green}"/></Trigger>
            <Trigger Property="Tag" Value="{x:Static tools:ToolLevel.Warn}"><Setter Property="Fill" Value="{DynamicResource B.Amber}"/></Trigger>
            <Trigger Property="Tag" Value="{x:Static tools:ToolLevel.Bad}"><Setter Property="Fill" Value="{DynamicResource B.Red}"/></Trigger>
            <Trigger Property="Tag" Value="{x:Static tools:ToolLevel.Checking}"><Setter Property="Fill" Value="{DynamicResource B.Cyan}"/></Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================== แถบเลื่อนบาง -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Border Margin="1,0" CornerRadius="3" Background="{DynamicResource B.Thumb}"/>
                                    </ControlTemplate></Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
