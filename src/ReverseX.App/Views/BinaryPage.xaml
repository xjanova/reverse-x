<UserControl x:Class="ReverseX.App.Views.BinaryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- แถวในลิสต์ที่ไม่มีกรอบเลือกของระบบ -->
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SymbolItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Pill" CornerRadius="10" BorderThickness="1.5" BorderBrush="Transparent" Padding="10,5" Margin="0,1" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Mono}" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource B.Text}" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text3}"
                                               ToolTip="{Binding Sub}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource B.Row}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource B.CyanSoft}"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource B.CyanSoftLine}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="MetaRowTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource B.Text3}" FontSize="12" VerticalAlignment="Top"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontFamily="{StaticResource F.Mono}" FontSize="12"
                           Foreground="{DynamicResource B.Text}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="WideRowTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" FontFamily="{StaticResource F.Mono}" FontSize="12" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource B.Text2}" ToolTip="{Binding Label}"/>
                <TextBlock Grid.Column="1" Text="{Binding Value}" Margin="14,0,0,0" FontFamily="{StaticResource F.Mono}" FontSize="12"
                           Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis" MaxWidth="240" ToolTip="{Binding Value}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CilRowTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Offset}" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{DynamicResource B.Gold}"/>
                <TextBlock Grid.Column="1" Text="{Binding Opcode}" FontFamily="{StaticResource F.Mono}" FontSize="12" Foreground="{DynamicResource B.Cyan}"/>
                <TextBlock Grid.Column="2" Text="{Binding Operand}" FontFamily="{StaticResource F.Mono}" FontSize="12"
                           Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Operand}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,12,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- หัวเรื่อง -->
        <Grid Margin="4,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource T.H1}" Text="{Binding TargetName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource T.Sub}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}" Text="{Binding Subtitle}"/>
                <TextBlock Margin="2,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}" Text="{Binding StatusLine}" ToolTip="{Binding StatusLine}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Run.Reanalyze}" Command="{Binding ReanalyzeCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Btn.OpenFile}" Command="{Binding PickCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- ว่าง -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                    <Image Source="/ReverseX;component/Assets/Icons3D/binary.png" Width="120" Height="120" Style="{StaticResource Icon3D}"/>
                    <TextBlock Style="{StaticResource T.H2}" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,0" Text="{DynamicResource S.Bin.Empty.Title}"/>
                    <TextBlock Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource B.Text2}"
                               Text="{DynamicResource S.Bin.Empty.Body}"/>
                    <Button Style="{StaticResource Btn.Aqua}" HorizontalAlignment="Center" Content="{DynamicResource S.Btn.OpenFile}" Command="{Binding PickCommand}"/>
                </StackPanel>
            </ContentControl>

            <!-- กำลังวิเคราะห์ -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding IsRunning, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="420">
                    <TextBlock Style="{StaticResource T.H2}" FontSize="18" HorizontalAlignment="Center" Text="{DynamicResource S.Run.Running}"/>
                    <ProgressBar Height="10" Margin="0,16,0,10" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIndeterminate}"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Text="{Binding ProgressText}"/>
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="{DynamicResource S.Run.Cancel}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </ContentControl>

            <!-- ผิดพลาด / ยกเลิก -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding IsFailed, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource B.Text}" Text="{Binding ErrorText}"/>
                    <Button Style="{StaticResource Btn.Aqua}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="{DynamicResource S.Run.Reanalyze}"
                            Command="{Binding ReanalyzeCommand}"/>
                </StackPanel>
            </ContentControl>

            <!-- ผลลัพธ์: สามคอลัมน์ (มีรายชื่อ symbol) -->
            <Grid Visibility="{Binding ShowSymbolPanes, Converter={StaticResource B2V}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="268"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- ซ้าย: รายการ -->
                <ContentControl Style="{StaticResource GlassCard}" Padding="12" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBox Style="{StaticResource SearchBox}" Tag="{Binding SearchHint}" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,8,0,6">
                            <ContentControl Style="{StaticResource Chip.Cyan}" Content="{Binding AllCountText}"/>
                            <ContentControl Style="{StaticResource Chip.Violet}" Margin="6,0,0,0" Content="{Binding TypeCountText}"
                                            Visibility="{Binding HasTypeCount, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                        <ListBox Grid.Row="2" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource SymbolItem}"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                        <TextBlock Grid.Row="3" Margin="4,6,0,0" FontSize="11" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Text="{Binding ListNote}"/>
                    </Grid>
                </ContentControl>

                <!-- กลาง: แท็บ -->
                <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,12,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="bintab" Style="{StaticResource Seg}" Content="{Binding FirstTabLabel}" IsChecked="{Binding TabCil, Mode=TwoWay}" Margin="0,0,6,0"/>
                            <RadioButton GroupName="bintab" Style="{StaticResource Seg}" Content="{DynamicResource S.Bin.Tab.Meta}" IsChecked="{Binding TabMeta, Mode=TwoWay}" Margin="0,0,6,0"
                                         Visibility="{Binding IsDotNet, Converter={StaticResource B2V}}"/>
                            <RadioButton GroupName="bintab" Style="{StaticResource Seg}" Content="{DynamicResource S.Bin.Tab.Native}" IsChecked="{Binding TabNative, Mode=TwoWay}" Margin="0,0,6,0"
                                         Visibility="{Binding IsNative, Converter={StaticResource B2V}}"/>
                            <RadioButton GroupName="bintab" Style="{StaticResource Seg}" Content="{DynamicResource S.Bin.Tab.Go}" IsChecked="{Binding TabGo, Mode=TwoWay}"
                                         Visibility="{Binding HasGo, Converter={StaticResource B2V}}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="2,12,0,8" Visibility="{Binding ShowCil, Converter={StaticResource B2V}}">
                            <TextBlock Style="{StaticResource T.H2}" Text="{Binding SelectedTitle}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource F.Mono}"/>
                            <TextBlock Style="{StaticResource T.Sub}" Margin="0,2,0,0" Text="{Binding CilHeader}" FontFamily="{StaticResource F.Mono}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- CIL -->
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid Visibility="{Binding ShowCil, Converter={StaticResource B2V}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Margin="2,0,0,6" Text="{Binding CilNote}"/>
                                <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource B.Input}" BorderBrush="{DynamicResource B.InputLine}" BorderThickness="1" Padding="12,8">
                                    <ListBox ItemsSource="{Binding CilRows}" ItemTemplate="{StaticResource CilRowTemplate}" ItemContainerStyle="{StaticResource PlainItem}"
                                             Background="Transparent" BorderThickness="0" Focusable="False"
                                             VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </Border>
                            </Grid>

                            <!-- metadata -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowMeta, Converter={StaticResource B2V}}">
                                <StackPanel Margin="2,4,10,0">
                                    <ItemsControl ItemsSource="{Binding MetaRows}" ItemTemplate="{StaticResource MetaRowTemplate}"/>
                                    <TextBlock Style="{StaticResource T.H2}" FontSize="14" Margin="0,16,0,6" Text="{DynamicResource S.Meta.Limits}"/>
                                    <ItemsControl ItemsSource="{Binding Limitations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5" Foreground="{DynamicResource B.Text2}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- native: ข้อมูลไฟล์ -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowNativeInfo, Converter={StaticResource B2V}}">
                                <ItemsControl Margin="2,4,10,0" ItemsSource="{Binding NativeRows}" ItemTemplate="{StaticResource MetaRowTemplate}"/>
                            </ScrollViewer>

                            <!-- Go -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding ShowGo, Converter={StaticResource B2V}}">
                                <StackPanel Margin="2,4,10,0">
                                    <ItemsControl ItemsSource="{Binding GoRows}" ItemTemplate="{StaticResource MetaRowTemplate}"/>
                                    <TextBlock Style="{StaticResource T.H2}" FontSize="14" Margin="0,14,0,6" Text="{Binding GoDepsTitle}"/>
                                    <ItemsControl ItemsSource="{Binding GoDeps}" ItemTemplate="{StaticResource WideRowTemplate}"/>
                                    <TextBlock Style="{StaticResource T.H2}" FontSize="14" Margin="0,14,0,6" Text="{DynamicResource S.Go.Settings}"/>
                                    <ItemsControl ItemsSource="{Binding GoSettings}" ItemTemplate="{StaticResource WideRowTemplate}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </ContentControl>

                <!-- ขวา: อ้างอิง + สรุป -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ContentControl Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{DynamicResource S.Bin.Refs}"/>
                            <ListBox Grid.Row="1" Margin="0,8,0,0" ItemsSource="{Binding Refs}" ItemContainerStyle="{StaticResource PlainItem}"
                                     Background="Transparent" BorderThickness="0" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Kind}" FontSize="10.5" Width="38" Foreground="{DynamicResource B.Gold}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource B.Text}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1" Margin="2,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource B.Text3}" Text="{DynamicResource S.Bin.NoRefs}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasRefs}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </ContentControl>
                    <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{DynamicResource S.Bin.Summary}"/>
                            <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Evidence}"/>
                            </ScrollViewer>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Grid>

            <!-- ผลลัพธ์แบบไม่มีรายชื่อ symbol: native ที่ไม่มี engine -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="22" Visibility="{Binding ShowCenterPlain, Converter={StaticResource B2V}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0" MaxWidth="760" HorizontalAlignment="Left">
                        <Grid Visibility="{Binding ShowNoEngine, Converter={StaticResource B2V}}" Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="/ReverseX;component/Assets/Icons3D/binary.png" Width="72" Height="72" Style="{StaticResource Icon3D}" VerticalAlignment="Top" Margin="0,0,16,0"/>
                            <StackPanel Grid.Column="1">
                                <ContentControl Style="{StaticResource Chip.Amber}" HorizontalAlignment="Left" Content="{DynamicResource S.Nat.NoEngine.Title}"/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource B.Text}" Text="{DynamicResource S.Nat.NoEngine.Body}"/>
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Nat.NoEngine.Hint}"/>
                                <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding EngineReasons}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,3" Foreground="{DynamicResource B.Text3}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource Btn.Violet}" HorizontalAlignment="Left" Margin="0,14,0,0" Content="{DynamicResource S.Nat.Guide}"
                                        Command="{Binding OpenGuideCommand}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource T.H2}" FontSize="15" Margin="0,0,0,6" Text="{DynamicResource S.Bin.Tab.Native}"/>
                        <ItemsControl ItemsSource="{Binding NativeRows}" ItemTemplate="{StaticResource MetaRowTemplate}"/>
                        <StackPanel Visibility="{Binding HasGo, Converter={StaticResource B2V}}">
                            <TextBlock Style="{StaticResource T.H2}" FontSize="15" Margin="0,20,0,6" Text="{DynamicResource S.Bin.Tab.Go}"/>
                            <ItemsControl ItemsSource="{Binding GoRows}" ItemTemplate="{StaticResource MetaRowTemplate}"/>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="14" Margin="0,12,0,6" Text="{Binding GoDepsTitle}"/>
                            <ItemsControl ItemsSource="{Binding GoDeps}" ItemTemplate="{StaticResource WideRowTemplate}"/>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="14" Margin="0,12,0,6" Text="{DynamicResource S.Go.Settings}"/>
                            <ItemsControl ItemsSource="{Binding GoSettings}" ItemTemplate="{StaticResource WideRowTemplate}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </ContentControl>

        </Grid>
    </Grid>
</UserControl>
