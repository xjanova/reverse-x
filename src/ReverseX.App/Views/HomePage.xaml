<UserControl x:Class="ReverseX.App.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tools="clr-namespace:ReverseX.Core.Tools;assembly=ReverseX.Core"
             xmlns:conv="clr-namespace:ReverseX.App.Converters"
             AllowDrop="True" Background="Transparent"
             DragEnter="OnDrag" DragOver="OnDrag" DragLeave="OnDragLeave" Drop="OnDrop">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InvB2V"/>
        <conv:ZeroToCollapsedConverter x:Key="ZeroHidden"/>
        <conv:Minus26Converter x:Key="Minus26"/>

        <!-- ชิปสถานะของเครื่องมือ: สีตาม ToolLevel -->
        <Style x:Key="LevelChip" TargetType="ContentControl" BasedOn="{StaticResource Chip.Grey}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static tools:ToolLevel.Ok}"><Setter Property="Background" Value="{DynamicResource B.GreenSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.GreenSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.GreenText}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static tools:ToolLevel.Warn}"><Setter Property="Background" Value="{DynamicResource B.AmberSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.AmberSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.AmberText}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static tools:ToolLevel.Bad}"><Setter Property="Background" Value="{DynamicResource B.RedSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.RedSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.RedText}"/></DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="{x:Static tools:ToolLevel.Checking}"><Setter Property="Background" Value="{DynamicResource B.CyanSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.CyanSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.CyanText}"/></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DropRect" TargetType="Rectangle">
            <Setter Property="RadiusX" Value="18"/>
            <Setter Property="RadiusY" Value="18"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeDashArray" Value="4 3"/>
            <Setter Property="Stroke" Value="{DynamicResource B.DropLine}"/>
            <Setter Property="Fill" Value="{DynamicResource B.DropFill}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource B.DropLineActive}"/>
                    <Setter Property="StrokeThickness" Value="2.4"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DropTitle" TargetType="TextBlock" BasedOn="{StaticResource T.H2}">
            <Setter Property="Text" Value="{DynamicResource S.Drop.Title}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                    <Setter Property="Text" Value="{DynamicResource S.Drop.Active}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="18,12,18,14"
              MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource Minus26}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="300"/>
            </Grid.RowDefinitions>

            <!-- ===== หัวหน้า: ชื่อ + ป้ายสถานะ -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,12,0">
                    <TextBlock Style="{StaticResource T.H1}" Text="{DynamicResource S.Home.Title}" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource T.Sub}" Margin="12,6,0,0" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource B.Text2}"
                               Text="{DynamicResource S.Home.Subtitle}" MaxWidth="260" TextWrapping="NoWrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Chip.Cyan}" Padding="12,5" FontSize="12.5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding ReaLevel}" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding ReaPillText}"/>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource Chip.Violet}" Padding="12,5" FontSize="12.5" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource B.Violet}" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource S.Pill.Ai}"/>
                        </StackPanel>
                    </ContentControl>
                    <ContentControl Style="{StaticResource Chip.Green}" Padding="12,5" FontSize="12.5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource B.Green}" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource S.Pill.Local}"/>
                        </StackPanel>
                    </ContentControl>
                </StackPanel>
            </Grid>

            <!-- ===== แถบแจ้งผล / ข้อผิดพลาด (ข้อความไทย ไม่โชว์ Exception ดิบ) -->
            <ContentControl Grid.Row="1" Margin="0,0,0,12" Padding="14,9" Focusable="False"
                            Visibility="{Binding HasNotice, Converter={StaticResource B2V}}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl" BasedOn="{StaticResource Chip.Cyan}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource B.RedSoft}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource B.RedSoftLine}"/>
                                <Setter Property="Foreground" Value="{DynamicResource B.RedText}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
                <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12.5" FontWeight="Normal" VerticalAlignment="Center" TextAlignment="Left"/>
                    <Button Grid.Column="1" Style="{StaticResource Btn.Mini}" Content="&#xE711;" Margin="12,0,0,0"
                            Command="{Binding DismissNoticeCommand}" ToolTip="{DynamicResource S.Notice.Dismiss}"/>
                </Grid>
            </ContentControl>

            <!-- ===== ฮีโร่ + ช่องลากไฟล์ -->
            <ContentControl Grid.Row="2" Style="{StaticResource ChromeCard}" Padding="22,20" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0" Source="/ReverseX;component/Assets/Logo/reversex-logo-512.png" Width="150" Height="150" Margin="0,0,22,0"
                           Style="{StaticResource Icon3D}" Effect="{DynamicResource E.Logo}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock FontFamily="{StaticResource F.Head}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"
                                   Text="{DynamicResource S.Hero.Line1}" TextWrapping="Wrap"/>
                        <TextBlock FontFamily="{StaticResource F.Head}" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource B.Headline}"
                                   Text="{DynamicResource S.Hero.Line2}" TextWrapping="Wrap"/>
                        <TextBlock Margin="0,10,0,12" FontSize="13" LineHeight="21" Foreground="{DynamicResource B.Text2}" TextWrapping="Wrap"
                                   Text="{DynamicResource S.Hero.Body}"/>
                        <WrapPanel>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="EXE"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="DLL"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="ELF"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="Mach-O"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="APK"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="ASAR"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content=".NET"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="WASM"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="SQLite"/>
                            <ContentControl Style="{StaticResource Chip}" Margin="0,0,6,6" Content="HAR"/>
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Column="2" Width="290" MinHeight="170" VerticalAlignment="Center">
                        <Rectangle Style="{StaticResource DropRect}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14,12">
                            <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource B.AquaGloss}" BorderBrush="{StaticResource B.GoldRing}"
                                    BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource T.Glyph}" Text="&#xE898;" FontSize="24" Foreground="{StaticResource B.AquaText}"/>
                            </Border>
                            <TextBlock Style="{StaticResource DropTitle}" FontSize="14.5"/>
                            <TextBlock Style="{StaticResource T.Sub}" Margin="0,3,0,10" TextAlignment="Center" TextWrapping="Wrap" TextTrimming="None"
                                       Text="{DynamicResource S.Drop.Hint}"/>
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Btn.PickFile}" Margin="3" Click="OnPickFile"/>
                                <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Btn.PickFolder}" Margin="3" Click="OnPickFolder"/>
                            </WrapPanel>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Style="{StaticResource SearchBox}" Height="32" Tag="{DynamicResource S.Play.Hint}" MaxLength="500"
                                         Text="{Binding PlayLink, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding FetchCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Btn.Fetch}" Margin="6,0,0,0"
                                        Command="{Binding FetchCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ContentControl>

            <!-- ===== การ์ดตัวเลข 4 ใบ -->
            <Grid Grid.Row="3" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,14,0">
                    <DockPanel>
                        <Image DockPanel.Dock="Right" Source="/ReverseX;component/Assets/Icons3D/binary.png" Width="48" Height="48" Style="{StaticResource Icon3D}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Body}" FontWeight="Medium" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Stat.Projects}"/>
                            <TextBlock Style="{StaticResource T.Num}" Text="{Binding ProjectCountText}"/>
                            <TextBlock Style="{StaticResource T.Sub}" Text="{Binding ProjectsSub}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
                <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,14,0">
                    <DockPanel>
                        <Image DockPanel.Dock="Right" Source="/ReverseX;component/Assets/Icons3D/function.png" Width="48" Height="48" Style="{StaticResource Icon3D}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Body}" FontWeight="Medium" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Stat.Functions}"/>
                            <TextBlock Style="{StaticResource T.Num}" Text="0"/>
                            <TextBlock Style="{StaticResource T.Sub}" Text="{DynamicResource S.Stat.FunctionsSub}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
                <ContentControl Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,14,0">
                    <DockPanel>
                        <Image DockPanel.Dock="Right" Source="/ReverseX;component/Assets/Icons3D/evidence.png" Width="48" Height="48" Style="{StaticResource Icon3D}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Body}" FontWeight="Medium" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Stat.Evidence}"/>
                            <TextBlock Style="{StaticResource T.Num}" Text="0"/>
                            <TextBlock Style="{StaticResource T.Sub}" Text="{DynamicResource S.Stat.EvidenceSub}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
                <ContentControl Grid.Column="3" Style="{StaticResource GlassCard}" Padding="16,12">
                    <DockPanel>
                        <Image DockPanel.Dock="Right" Source="/ReverseX;component/Assets/Icons3D/unknown.png" Width="48" Height="48" Style="{StaticResource Icon3D}" VerticalAlignment="Top" Margin="6,0,0,0"/>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.Body}" FontWeight="Medium" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Stat.Unknown}"/>
                            <TextBlock Style="{StaticResource T.Num}" Text="0"/>
                            <TextBlock Style="{StaticResource T.Sub}" Text="{DynamicResource S.Stat.UnknownSub}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </ContentControl>
            </Grid>

            <!-- ===== แถวล่าง: โปรเจกต์ล่าสุด · เครื่องมือ · ลองถาม AI -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- โปรเจกต์ล่าสุด -->
                <ContentControl Grid.Column="0" Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource T.H2}" Text="{DynamicResource S.Recent.Title}" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource Badge}" Margin="8,0,0,0" Content="{Binding TotalCount}"
                                                Visibility="{Binding ShowEmpty, Converter={StaticResource InvB2V}}"/>
                            </StackPanel>
                            <TextBox Grid.Column="2" Width="150" Style="{StaticResource SearchBox}" Tag="{DynamicResource S.Recent.Search}"
                                     Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Projects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Row" CornerRadius="12" Padding="8,7" Margin="0,0,0,2" Background="Transparent" Cursor="Hand"
                                                    ToolTip="{DynamicResource S.Recent.Open}">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding Icon}" Width="34" Height="34" Style="{StaticResource Icon3D}" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="{Binding Name}" ToolTip="{Binding Path}"/>
                                                        <TextBlock Style="{StaticResource T.Sub}" FontSize="11.5" Text="{Binding Sub}"/>
                                                    </StackPanel>
                                                    <ContentControl Grid.Column="2" Style="{StaticResource Chip.Grey}" Margin="8,0,6,0" VerticalAlignment="Center"
                                                                    Content="{Binding StatusText}"/>
                                                    <Button x:Name="Del" Grid.Column="3" Style="{StaticResource Btn.Mini}" Content="&#xE711;" Opacity="0.35"
                                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" ToolTip="{DynamicResource S.Recent.Remove}"/>
                                                </Grid>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource B.Row}"/>
                                                    <Setter TargetName="Del" Property="Opacity" Value="1"/>
                                                </Trigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- สถานะว่าง -->
                                <StackPanel HorizontalAlignment="Center" Margin="0,22,0,0" MaxWidth="320"
                                            Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}">
                                    <Image Source="/ReverseX;component/Assets/Icons3D/binary.png" Width="84" Height="84" Style="{StaticResource Icon3D}" Opacity="0.9"/>
                                    <TextBlock Style="{StaticResource T.H2}" FontSize="17" HorizontalAlignment="Center" Margin="0,10,0,4" Text="{DynamicResource S.Recent.EmptyTitle}"/>
                                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Recent.EmptyBody}"/>
                                </StackPanel>
                                <TextBlock HorizontalAlignment="Center" Margin="0,24,0,0" Foreground="{DynamicResource B.Text3}" FontSize="12.5"
                                           Text="{DynamicResource S.Recent.NoMatch}" Visibility="{Binding ShowNoMatch, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>

                <!-- เครื่องมือแกะในเครื่องนี้ -->
                <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" Padding="16,14" Margin="0,0,14,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,8" Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource T.H2}" Text="{DynamicResource S.Tools.Title}" VerticalAlignment="Center"/>
                                <ContentControl Style="{StaticResource Badge}" Margin="8,0,0,0" Content="{Binding ToolProblemCount}">
                                    <ContentControl.Visibility>
                                        <Binding Path="ToolProblemCount" Converter="{StaticResource ZeroHidden}"/>
                                    </ContentControl.Visibility>
                                </ContentControl>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" MinHeight="26" Padding="12,2" FontSize="12"
                                    Content="{DynamicResource S.Tools.Recheck}" Command="{Binding RecheckCommand}"/>
                        </Grid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Tools}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="12" Padding="8,6" Margin="0,0,0,2" Background="{DynamicResource B.Row}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Image Source="{Binding Icon}" Width="30" Height="30" Style="{StaticResource Icon3D}" VerticalAlignment="Top" Margin="0,1,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource T.Body}" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                        <ContentControl Grid.Column="1" Style="{StaticResource LevelChip}" Padding="8,1" FontSize="10.5" Margin="6,0,8,0"
                                                                        Content="{Binding LevelText}"/>
                                                        <Ellipse Grid.Column="2" Style="{StaticResource StatusDot}" Tag="{Binding Level}"/>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource T.Sub}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="46" Margin="0,2,0,0" Text="{Binding Message}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>

                <!-- ลองถาม AI -->
                <ContentControl Grid.Column="2" Style="{StaticResource GlassCard}" Padding="16,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Height="28">
                            <Image Source="/ReverseX;component/Assets/Icons3D/ai.png" Width="24" Height="24" Style="{StaticResource Icon3D}" Margin="0,0,8,0"/>
                            <TextBlock Style="{StaticResource T.H2}" Text="{DynamicResource S.Ask.Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,8" Background="{DynamicResource B.VioletSoft}" BorderBrush="{DynamicResource B.VioletSoftLine}" BorderThickness="1">
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text}" Text="{DynamicResource S.Ask.Q1}"/>
                                </Border>
                                <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,8" Background="{DynamicResource B.VioletSoft}" BorderBrush="{DynamicResource B.VioletSoftLine}" BorderThickness="1">
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text}" Text="{DynamicResource S.Ask.Q2}"/>
                                </Border>
                                <Border CornerRadius="12" Padding="12,9" Margin="0,0,0,8" Background="{DynamicResource B.VioletSoft}" BorderBrush="{DynamicResource B.VioletSoftLine}" BorderThickness="1">
                                    <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text}" Text="{DynamicResource S.Ask.Q3}"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="2" Style="{StaticResource Btn.Violet}" MinHeight="36" Margin="0,6,0,0"
                                Content="{DynamicResource S.Ask.Open}" Command="{Binding OpenAiCommand}"/>
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
