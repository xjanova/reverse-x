<UserControl x:Class="ReverseX.App.Views.EvidencePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>

    <Grid Margin="18,12,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource T.H1}" Text="{DynamicResource S.Nav.Evidence}"/>
                <TextBlock Style="{StaticResource T.Sub}" Margin="2,8,0,0" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}"
                           TextWrapping="Wrap" Text="{DynamicResource S.Evi.Sub}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Evi.Export}" Command="{Binding ExportCommand}" HorizontalAlignment="Right"/>
                <TextBlock Margin="0,4,0,0" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}" Text="{Binding Notice}"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Visibility="{Binding HasItems, Converter={StaticResource B2V}}">
            <RadioButton GroupName="evi" Style="{StaticResource Seg}" Margin="0,0,6,0" Content="{Binding AllText}" IsChecked="{Binding ShowAll, Mode=TwoWay}"/>
            <RadioButton GroupName="evi" Style="{StaticResource Seg}" Margin="0,0,6,0" Content="{Binding SeenText}" IsChecked="{Binding ShowSeen, Mode=TwoWay}"/>
            <RadioButton GroupName="evi" Style="{StaticResource Seg}" Margin="0,0,6,0" Content="{Binding InferredText}" IsChecked="{Binding ShowInferred, Mode=TwoWay}"/>
            <RadioButton GroupName="evi" Style="{StaticResource Seg}" Content="{Binding UnknownText}" IsChecked="{Binding ShowUnknown, Mode=TwoWay}"/>
        </StackPanel>

        <ContentControl Grid.Row="2" Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                <Image Source="/ReverseX;component/Assets/Icons3D/evidence.png" Width="120" Height="120" Style="{StaticResource Icon3D}"/>
                <TextBlock Style="{StaticResource T.H2}" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,0" Text="{DynamicResource S.Evi.Empty.Title}"/>
                <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Evi.Empty.Body}"/>
            </StackPanel>
        </ContentControl>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasItems, Converter={StaticResource B2V}}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Margin="0,2,0,10" FontSize="11" FontFamily="{StaticResource F.Mono}" Foreground="{DynamicResource B.Text3}"
                                           Text="{Binding Path}" ToolTip="{Binding Path}" TextTrimming="CharacterEllipsis"/>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentControl Content="{Binding Badge}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <ContentControl.Style>
                                                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip.Green}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Inferred"><Setter Property="Background" Value="{DynamicResource B.AmberSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.AmberSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.AmberText}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource B.RedSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.RedSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.RedText}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ContentControl.Style>
                                                </ContentControl>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
