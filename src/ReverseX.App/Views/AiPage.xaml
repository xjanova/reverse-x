<UserControl x:Class="ReverseX.App.Views.AiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReverseX.App.ViewModels"
             xmlns:conv="clr-namespace:ReverseX.App.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <conv:InverseBoolToVisibilityConverter x:Key="NotB2V"/>

        <Style x:Key="Bubble" TargetType="Border">
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="13,10"/>
        </Style>

        <!-- one timeline step -->
        <DataTemplate DataType="{x:Type vm:StepVm}">
            <Border CornerRadius="11" Margin="0,0,0,6" Padding="9,6" Background="{DynamicResource B.Row}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding Icon}" Width="24" Height="24" Style="{StaticResource Icon3D}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text}"/>
                        <TextBlock FontFamily="{StaticResource F.Mono}" FontSize="10.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text3}">
                            <Run Text="{Binding Tool, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding Detail, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Elapsed}" FontFamily="{StaticResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.Text3}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Width="16" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="✓"/>
                                    <Setter Property="Foreground" Value="{DynamicResource B.GreenText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="Running"><Setter Property="Text" Value="●"/><Setter Property="Foreground" Value="{DynamicResource B.Cyan}"/></DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Failed"><Setter Property="Text" Value="✕"/><Setter Property="Foreground" Value="{DynamicResource B.RedText}"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- chat messages -->
        <DataTemplate DataType="{x:Type vm:ChatMessageVm}">
            <Grid Margin="0,0,0,12">
                <!-- user -->
                <Border Style="{StaticResource Bubble}" HorizontalAlignment="Right" MaxWidth="560" Background="{DynamicResource B.VioletSoft}"
                        BorderBrush="{DynamicResource B.VioletSoftLine}" BorderThickness="1" Visibility="{Binding IsUser, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource B.Text}"/>
                </Border>
                <!-- assistant -->
                <StackPanel Visibility="{Binding IsBot, Converter={StaticResource B2V}}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Margin="2,0,0,6">
                        <Image Source="/ReverseX;component/Assets/Icons3D/ai.png" Width="20" Height="20" Style="{StaticResource Icon3D}"/>
                        <TextBlock Text="{DynamicResource S.Ai.Who}" FontWeight="SemiBold" FontSize="12" Margin="6,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Text2}"/>
                        <ContentControl Style="{StaticResource Chip.Cyan}" Content="{Binding StatusChip}" Visibility="{Binding HasStatusChip, Converter={StaticResource B2V}}"/>
                        <ContentControl Style="{StaticResource Chip.Violet}" Content="{DynamicResource S.Ai.Thinking}" Margin="6,0,0,0" Visibility="{Binding IsThinking, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False"/>
                    <Border Style="{StaticResource Bubble}" Background="{DynamicResource B.Row}" BorderBrush="{DynamicResource B.Line}" BorderThickness="1"
                            Visibility="{Binding HasText, Converter={StaticResource B2V}}" Margin="0,2,0,0">
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" LineHeight="20" Foreground="{DynamicResource B.Text}"/>
                    </Border>
                    <Border Margin="0,6,0,0" Visibility="{Binding HasNotice, Converter={StaticResource B2V}}">
                        <Border CornerRadius="12" Padding="12,9" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource B.AmberSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource B.AmberSoftLine}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource B.RedSoft}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource B.RedSoftLine}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text}"/>
                        </Border>
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- code proposal with diff -->
        <DataTemplate DataType="{x:Type vm:ProposalVm}">
            <Border CornerRadius="14" Margin="0,0,0,12" Padding="12,10" Background="{DynamicResource B.Row}" BorderBrush="{DynamicResource B.GoldRing}" BorderThickness="1">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/ReverseX;component/Assets/Icons3D/function.png" Width="22" Height="22" Style="{StaticResource Icon3D}"/>
                        <TextBlock Text="{DynamicResource S.Ai.Prop.Title}" FontWeight="SemiBold" Margin="7,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Path}" FontFamily="{StaticResource F.Mono}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource B.Gold}" TextTrimming="CharacterEllipsis"/>
                        <ContentControl Style="{StaticResource Chip.Green}" Content="{DynamicResource S.Ai.Prop.New}" Margin="8,0,0,0" Visibility="{Binding IsNewFile, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,6" Foreground="{DynamicResource B.Text2}"/>
                    <Border CornerRadius="10" Background="{DynamicResource B.Input}" BorderBrush="{DynamicResource B.InputLine}" BorderThickness="1" Padding="0,6" MaxHeight="220">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding DiffLines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DiffLineVm}">
                                        <TextBlock Text="{Binding Text}" FontFamily="{StaticResource F.Mono}" FontSize="11.5" Padding="10,1">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Kind}" Value="+"><Setter Property="Background" Value="{DynamicResource B.GreenSoft}"/><Setter Property="Foreground" Value="{DynamicResource B.GreenText}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="-"><Setter Property="Background" Value="{DynamicResource B.RedSoft}"/><Setter Property="Foreground" Value="{DynamicResource B.RedText}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Kind}" Value="@"><Setter Property="Foreground" Value="{DynamicResource B.CyanText}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Visibility="{Binding IsPending, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" Foreground="{DynamicResource B.RedText}"/>
                        <TextBlock Text="{DynamicResource S.Ai.Prop.Note}" FontSize="11" Margin="0,6,0,0" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Ai.Prop.Confirm}" Command="{Binding ApplyCommand}" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Ai.Prop.Reject}" Command="{Binding RejectCommand}"/>
                        </StackPanel>
                    </StackPanel>
                    <ContentControl Style="{StaticResource Chip.Green}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{Binding Message}" Visibility="{Binding IsApplied, Converter={StaticResource B2V}}"/>
                    <ContentControl Style="{StaticResource Chip.Grey}" HorizontalAlignment="Left" Margin="0,8,0,0" Content="{DynamicResource S.Ai.Prop.Rejected}" Visibility="{Binding IsRejected, Converter={StaticResource B2V}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- flow node -->
        <DataTemplate DataType="{x:Type vm:FlowNodeVm}">
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="12" Padding="8,6" MinWidth="86" BorderThickness="1" Margin="0,2,0,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource B.Row}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHot}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource B.VioletSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource B.VioletSoftLine}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Image Source="{Binding Icon}" Width="26" Height="26" Style="{StaticResource Icon3D}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="86" Margin="0,3,0,0" Foreground="{DynamicResource B.Text}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="›" FontSize="16" Margin="5,0" VerticalAlignment="Center" Foreground="{DynamicResource B.Text3}"/>
            </StackPanel>
        </DataTemplate>

        <!-- evidence row -->
        <DataTemplate DataType="{x:Type vm:EvidenceItemVm}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding Badge}" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip.Green}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSeen}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource B.AmberSoft}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource B.AmberSoftLine}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource B.AmberText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Location}" FontFamily="{StaticResource F.Mono}" FontSize="11" Foreground="{DynamicResource B.Gold}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasLocation, Converter={StaticResource B2V}}"/>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource B.Text}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="18,12,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- heading -->
        <Grid Margin="4,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource T.H1}" Text="{DynamicResource S.Nav.Ai}"/>
                <TextBlock Style="{StaticResource T.Sub}" Margin="2,8,0,0" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}" Text="{DynamicResource S.Ai.Desc}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ContentControl Style="{StaticResource Chip.Violet}" Content="{Binding ModelName}" Margin="0,0,8,0" Padding="12,5"/>
                <ContentControl Style="{StaticResource Chip.Amber}" Content="{Binding EvidencePill}" Padding="12,5"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- ===== chat card -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- target + own project -->
                    <WrapPanel Margin="0,0,0,8">
                        <ContentControl Style="{StaticResource Chip.Cyan}" Content="{Binding TargetChip}" Margin="0,0,8,4" Padding="12,4"/>
                        <ContentControl Style="{StaticResource Chip.Amber}" Content="{Binding OwnFolderChip}" Margin="0,0,8,4" Padding="12,4" Visibility="{Binding HasOwnFolder, Converter={StaticResource B2V}}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Padding="11,4" FontSize="11.5" MinHeight="0" Content="{DynamicResource S.Ai.Btn.PickOwn}" Command="{Binding PickOwnFolderCommand}" Margin="0,0,6,4"/>
                        <Button Style="{StaticResource Btn.Ghost}" Padding="11,4" FontSize="11.5" MinHeight="0" Content="{DynamicResource S.Ai.Btn.ClearOwn}" Command="{Binding ClearOwnFolderCommand}" Margin="0,0,6,4" Visibility="{Binding HasOwnFolder, Converter={StaticResource B2V}}"/>
                        <Button Style="{StaticResource Btn.Ghost}" Padding="11,4" FontSize="11.5" MinHeight="0" Content="{DynamicResource S.Ai.Btn.NewChat}" Command="{Binding NewChatCommand}" Margin="0,0,6,4"/>
                        <Button Style="{StaticResource Btn.Ghost}" Padding="11,4" FontSize="11.5" MinHeight="0" Content="{DynamicResource S.Ai.Btn.Export}" Command="{Binding ExportCommand}" Margin="0,0,0,4" Visibility="{Binding HasConversation, Converter={StaticResource B2V}}"/>
                    </WrapPanel>

                    <!-- conversation / empty states -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" ScrollChanged="OnScrollChanged"
                                      Visibility="{Binding HasConversation, Converter={StaticResource B2V}}">
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False"/>
                        </ScrollViewer>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470" Visibility="{Binding ShowNoKey, Converter={StaticResource B2V}}">
                            <Image Source="/ReverseX;component/Assets/Icons3D/settings.png" Width="96" Height="96" Style="{StaticResource Icon3D}"/>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="19" HorizontalAlignment="Center" Margin="0,12,0,0" Text="{DynamicResource S.Ai.NoKey.Title}"/>
                            <TextBlock Margin="0,8,0,14" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Ai.NoKey.Body}"/>
                            <Button Style="{StaticResource Btn.Aqua}" HorizontalAlignment="Center" Content="{DynamicResource S.Ai.NoKey.Btn}" Command="{Binding GoSettingsCommand}"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="470" Visibility="{Binding ShowWelcome, Converter={StaticResource B2V}}">
                            <Image Source="/ReverseX;component/Assets/Icons3D/ai.png" Width="96" Height="96" Style="{StaticResource Icon3D}"/>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="19" HorizontalAlignment="Center" Margin="0,12,0,0" Text="{DynamicResource S.Ai.Welcome.Title}"/>
                            <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Ai.Welcome.Body}"/>
                        </StackPanel>
                    </Grid>

                    <!-- suggestions -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Suggestions}" Margin="0,8,0,6" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SuggestionVm}">
                                <Button Margin="0,0,6,4" Content="{Binding Text}" Command="{Binding DataContext.SuggestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding Text}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Primary}" Value="True"><Setter Property="Foreground" Value="{DynamicResource B.AmberText}"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- input -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InputBox" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" Tag="{DynamicResource S.Ai.Input.Hint}"
                                 Style="{StaticResource SearchBox}" Height="38" FontSize="13" AcceptsReturn="False" MaxLength="4000" IsEnabled="{Binding CanSend}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SendCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Margin="8,0,0,0" Height="38" MinWidth="86" Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Ai.Send}" Command="{Binding SendCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource NotB2V}}"/>
                        <Button Grid.Column="1" Margin="8,0,0,0" Height="38" MinWidth="86" Style="{StaticResource Btn.Violet}" Content="{DynamicResource S.Ai.Stop}" Command="{Binding StopCommand}"
                                Visibility="{Binding IsRunning, Converter={StaticResource B2V}}"/>
                    </Grid>
                    <TextBlock Grid.Row="4" Margin="4,6,0,0" FontSize="11" Foreground="{DynamicResource B.Text3}" Text="{Binding CostText}" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </ContentControl>

            <!-- ===== right column -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ContentControl Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{DynamicResource S.Ai.Path.Title}"/>
                        <TextBlock Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource B.Text3}" Text="{DynamicResource S.Ai.Path.Empty}"
                                   Visibility="{Binding HasPath, Converter={StaticResource NotB2V}}"/>
                        <ItemsControl ItemsSource="{Binding PathNodes}" Margin="0,8,0,0" Focusable="False" Visibility="{Binding HasPath, Converter={StaticResource B2V}}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14,12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{DynamicResource S.Ai.Evidence}"/>
                            <TextBlock Margin="0,2,0,8" FontSize="11" Foreground="{DynamicResource B.Text3}" Text="{DynamicResource S.Ai.Evidence.Hint}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource B.Text3}" Text="{DynamicResource S.Ai.Evidence.Empty}" Visibility="{Binding HasNoEvidence, Converter={StaticResource B2V}}"/>
                                <ItemsControl ItemsSource="{Binding Evidence}" Focusable="False"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>

                <ContentControl Grid.Row="2" Style="{StaticResource GlassCard}" Padding="14,12" MaxHeight="170">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/ReverseX;component/Assets/Icons3D/unknown.png" Width="22" Height="22" Style="{StaticResource Icon3D}"/>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="15" Margin="6,0,0,6" Text="{DynamicResource S.Ai.Unknowns.Title}"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{DynamicResource B.Text3}" Text="{DynamicResource S.Ai.Unknowns.Empty}" Visibility="{Binding HasNoUnknowns, Converter={StaticResource B2V}}"/>
                                <ItemsControl ItemsSource="{Binding Unknowns}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,5" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource B.RedText}" Text="{Binding StringFormat='? {0}'}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
