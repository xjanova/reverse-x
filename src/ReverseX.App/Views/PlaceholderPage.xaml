<UserControl x:Class="ReverseX.App.Views.PlaceholderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,12,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource T.H1}" Text="{Binding Title}" Margin="4,4,0,0"/>
        <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" Margin="0,16,0,0" Padding="32">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                <Image Source="{Binding Icon}" Width="128" Height="128" Style="{StaticResource Icon3D}" Opacity="0.95"/>
                <ContentControl Style="{StaticResource Chip.Cyan}" HorizontalAlignment="Center" Margin="0,18,0,10" Padding="14,4" FontSize="12.5"
                                Content="{DynamicResource S.Soon.Title}"/>
                <TextBlock Style="{StaticResource T.H2}" FontSize="20" HorizontalAlignment="Center" Text="{Binding Title}"/>
                <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource B.Text2}"
                           Text="{Binding Desc}"/>
                <TextBlock Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource B.Text3}"
                           Text="{DynamicResource S.Soon.Body}"/>
            </StackPanel>
        </ContentControl>
    </Grid>
</UserControl>
