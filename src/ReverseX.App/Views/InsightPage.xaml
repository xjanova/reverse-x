<UserControl x:Class="ReverseX.App.Views.InsightPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
                    <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource B.Text2}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="{DynamicResource B.Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource B.Row}"/>
            <Style.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{DynamicResource B.RowAlt}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource B.Hover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,12,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource T.H1}" Text="{Binding TargetName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource T.Sub}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}"
                           Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}"/>
                <TextBlock Margin="2,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}"
                           Text="{Binding StatusLine}" ToolTip="{Binding StatusLine}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Run.Reanalyze}" Command="{Binding ReanalyzeCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Ins.PickFile}" Command="{Binding PickFileCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- ว่าง -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <Image Source="{Binding Icon}" Width="120" Height="120" Style="{StaticResource Icon3D}"/>
                    <TextBlock Style="{StaticResource T.H2}" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,0" Text="{DynamicResource S.Ins.Empty.Title}"/>
                    <TextBlock Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource B.Text2}" Text="{Binding EmptyBody}"/>
                    <Button Style="{StaticResource Btn.Aqua}" HorizontalAlignment="Center" Content="{DynamicResource S.Ins.PickFile}" Command="{Binding PickFileCommand}"/>
                </StackPanel>
            </ContentControl>

            <!-- กำลังวิเคราะห์ -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding IsRunning, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
                    <TextBlock Style="{StaticResource T.H2}" FontSize="18" HorizontalAlignment="Center" Text="{DynamicResource S.Run.Running}"/>
                    <ProgressBar Height="10" Margin="0,16,0,10" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIndeterminate}"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Text="{Binding ProgressText}"/>
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="{DynamicResource S.Run.Cancel}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </ContentControl>

            <!-- ผิดพลาด -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding IsFailed, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource B.Text}" Text="{Binding ErrorText}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Ins.PickFile}" Command="{Binding PickFileCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Run.Reanalyze}" Command="{Binding ReanalyzeCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- ผลลัพธ์ -->
            <Grid Visibility="{Binding IsReady, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource B.Text2}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.Num}" FontSize="24" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource B.Text2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}"/>
                                </StackPanel>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- ซ้าย: แท็บตาราง -->
                    <ContentControl Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Tabs}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Style="{StaticResource Seg}" Margin="0,0,6,6" Content="{Binding Title}" IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                             CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Width="200" Height="30" Margin="10,0,0,6" VerticalAlignment="Top"
                                         Tag="{DynamicResource S.Ins.Search}" DataContext="{Binding Tab}"
                                         Visibility="{Binding IsTable, Converter={StaticResource B2V}, FallbackValue=Collapsed}"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=200}"/>
                            </Grid>

                            <DataGrid x:Name="Table" Grid.Row="1" Margin="0,6,0,0" DataContext="{Binding Tab}" ItemsSource="{Binding View}"
                                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                      Visibility="{Binding IsTable, Converter={StaticResource B2V}, FallbackValue=Collapsed}"
                                      AutoGenerateColumns="True" AutoGeneratingColumn="OnAutoGeneratingColumn"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False"
                                      SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column" GridLinesVisibility="None"
                                      AlternationCount="2" Background="Transparent" BorderThickness="0" RowHeaderWidth="0"
                                      FontSize="12" Foreground="{DynamicResource B.Text}"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      CellStyle="{StaticResource GridCell}" ColumnHeaderStyle="{StaticResource GridHeader}" RowStyle="{StaticResource GridRow}"/>

                            <TextBox Grid.Row="1" Margin="0,6,0,0" DataContext="{Binding Tab}" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True"
                                     Visibility="{Binding IsText, Converter={StaticResource B2V}, FallbackValue=Collapsed}"
                                     FontFamily="{StaticResource F.Mono}" FontSize="12" Background="{DynamicResource B.Input}" Foreground="{DynamicResource B.Text}"
                                     BorderBrush="{DynamicResource B.InputLine}" Padding="8" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>

                            <TextBlock Grid.Row="2" Margin="2,6,0,0" FontSize="11" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap"
                                       DataContext="{Binding Tab}" Text="{Binding Note}"/>

                            <TextBox Grid.Row="3" Margin="0,8,0,0" Height="170" DataContext="{Binding Tab}" Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True"
                                     FontFamily="{StaticResource F.Mono}" FontSize="11.5" Background="{DynamicResource B.Input}" Foreground="{DynamicResource B.Text}"
                                     BorderBrush="{DynamicResource B.InputLine}" Padding="8" TextWrapping="NoWrap"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <TextBox.Style>
                                    <Style TargetType="TextBox">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasDetail}" Value="True"/>
                                                    <Condition Binding="{Binding IsTable}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>
                    </ContentControl>

                    <!-- ขวา: ข้อสังเกต -->
                    <ContentControl Grid.Column="1" Style="{StaticResource GlassCard}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{DynamicResource S.Ins.Title}"/>
                            <TextBlock Grid.Row="1" Margin="0,10,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource B.Text3}" Text="{DynamicResource S.Ins.None}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInsights}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Insights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border CornerRadius="3" Margin="0,2,0,2">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource B.Cyan}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Risk"><Setter Property="Background" Value="{DynamicResource B.Red}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Warn"><Setter Property="Background" Value="{DynamicResource B.Amber}"/></DataTrigger>
                                                                <DataTrigger Binding="{Binding Tone}" Value="Good"><Setter Property="Background" Value="{DynamicResource B.Green}"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text}"/>
                                                    <ContentControl Content="{Binding Badge}" HorizontalAlignment="Left" Margin="0,4,0,0">
                                                        <ContentControl.Style>
                                                            <Style TargetType="ContentControl" BasedOn="{StaticResource Chip.Green}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Inferred"><Setter Property="Background" Value="{DynamicResource B.AmberSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.AmberSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.AmberText}"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding Level}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource B.RedSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.RedSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.RedText}"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </ContentControl.Style>
                                                    </ContentControl>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </ContentControl>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
