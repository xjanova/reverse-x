<UserControl x:Class="ReverseX.App.Views.EngineSetupStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: EngineSetupViewModel (shared by Home and the Binary page) -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
    </UserControl.Resources>
    <StackPanel>
        <!-- offer: what is missing, download size and disk need -->
        <Border CornerRadius="12" Padding="10,8" Background="{DynamicResource B.Row}"
                Visibility="{Binding ShowOffer, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource T.Sub}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding OfferText}"/>
                <Button Grid.Column="1" Style="{StaticResource Btn.Violet}" MinHeight="26" Padding="12,2" FontSize="12" Margin="10,0,0,0"
                        VerticalAlignment="Center" Content="{DynamicResource S.Eng.Install}" ToolTip="{DynamicResource S.Eng.Install.Tip}"
                        Command="{Binding InstallCommand}"/>
            </Grid>
        </Border>

        <!-- running -->
        <Border CornerRadius="12" Padding="10,8" Background="{DynamicResource B.Row}"
                Visibility="{Binding IsBusy, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource T.Sub}" FontSize="11.5" TextWrapping="Wrap" Text="{Binding ProgressText}"/>
                    <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource Btn.Ghost}" MinHeight="26" Padding="12,2" FontSize="12" Margin="10,0,0,0"
                        VerticalAlignment="Center" Content="{DynamicResource S.Eng.Cancel}" Command="{Binding CancelCommand}"/>
            </Grid>
        </Border>

        <!-- last result -->
        <TextBlock Margin="2,6,2,0" FontSize="11.5" TextWrapping="Wrap" Text="{Binding ResultText}"
                   Visibility="{Binding HasResult, Converter={StaticResource B2V}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource B.GreenText}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource B.RedText}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
