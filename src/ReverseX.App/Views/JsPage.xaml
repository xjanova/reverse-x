<UserControl x:Class="ReverseX.App.Views.JsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,12,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="4,4,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource T.H1}" Text="{Binding TargetName}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Style="{StaticResource T.Sub}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}" Text="{Binding Subtitle}"/>
                <TextBlock Margin="2,2,0,0" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource B.Text}" Effect="{DynamicResource E.Title}" Text="{Binding StatusLine}" ToolTip="{Binding StatusLine}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Run.Reanalyze}" Command="{Binding ReanalyzeCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Btn.PickAsar}" Command="{Binding PickAsarCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Btn.PickFolder}" Command="{Binding PickFolderCommand}"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <!-- ว่าง -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
                    <Image Source="/ReverseX;component/Assets/Icons3D/javascript.png" Width="120" Height="120" Style="{StaticResource Icon3D}"/>
                    <TextBlock Style="{StaticResource T.H2}" FontSize="20" HorizontalAlignment="Center" Margin="0,14,0,0" Text="{DynamicResource S.Js.Empty.Title}"/>
                    <TextBlock Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource B.Text2}"
                               Text="{DynamicResource S.Js.Empty.Body}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Btn.PickAsar}" Command="{Binding PickAsarCommand}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn.Aqua}" Content="{DynamicResource S.Btn.PickFolder}" Command="{Binding PickFolderCommand}"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>

            <!-- กำลังวิเคราะห์ -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding IsRunning, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="440">
                    <TextBlock Style="{StaticResource T.H2}" FontSize="18" HorizontalAlignment="Center" Text="{DynamicResource S.Run.Running}"/>
                    <ProgressBar Height="10" Margin="0,16,0,10" Minimum="0" Maximum="100" Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIndeterminate}"/>
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource B.Text2}" Text="{Binding ProgressText}"/>
                    <Button Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="{DynamicResource S.Run.Cancel}"
                            Command="{Binding CancelCommand}"/>
                </StackPanel>
            </ContentControl>

            <!-- ผิดพลาด / ยกเลิก -->
            <ContentControl Style="{StaticResource GlassCard}" Padding="32" Visibility="{Binding IsFailed, Converter={StaticResource B2V}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
                    <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontSize="15" Foreground="{DynamicResource B.Text}" Text="{Binding ErrorText}"/>
                    <Button Style="{StaticResource Btn.Aqua}" HorizontalAlignment="Center" Margin="0,18,0,0" Content="{DynamicResource S.Run.Reanalyze}"
                            Command="{Binding ReanalyzeCommand}"/>
                </StackPanel>
            </ContentControl>

            <!-- ผลลัพธ์ -->
            <Grid Visibility="{Binding IsReady, Converter={StaticResource B2V}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- การ์ดสถิติ -->
                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,12">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource GlassCard}" Padding="14,10" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{DynamicResource B.Text2}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Value}" Style="{StaticResource T.Num}" FontSize="26" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Sub}" FontSize="11" Foreground="{DynamicResource B.Text2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}"/>
                                </StackPanel>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- คำเตือน integrity -->
                <ContentControl Grid.Row="1" Style="{StaticResource Chip.Amber}" HorizontalAlignment="Stretch" Padding="12,6" Margin="0,0,0,12"
                                Visibility="{Binding IntegrityWarning, Converter={StaticResource B2V}}">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Text="{DynamicResource S.Js.Warn.Integrity}"/>
                </ContentControl>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- ซ้าย: รายการโมดูลแบ่งหน้า -->
                    <ContentControl Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource T.H2}" FontSize="15" VerticalAlignment="Center" Text="{Binding ModuleTitle}"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SearchBox}" Height="30" Tag="{DynamicResource S.Js.Search}"
                                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <ListBox Grid.Row="1" Margin="0,10,0,6" ItemsSource="{Binding PageItems}" ItemContainerStyle="{StaticResource PlainItem}"
                                     Background="Transparent" BorderThickness="0" Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource F.Mono}" FontSize="12.5" Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Dir}" FontSize="10.5" Foreground="{DynamicResource B.Text3}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                            </StackPanel>
                                            <ContentControl Grid.Column="1" Style="{StaticResource Chip.Grey}" Margin="8,0,0,0" VerticalAlignment="Center" Content="{Binding Kind}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource B.Text3}" Text="{Binding ShowingText}"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap" Text="{Binding TruncatedNote}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource Btn.Mini}" Content="&#xE892;" FontFamily="{StaticResource F.Icon}" Command="{Binding FirstCommand}"/>
                                    <Button Style="{StaticResource Btn.Mini}" Content="&#xE76B;" FontFamily="{StaticResource F.Icon}" Command="{Binding PrevCommand}" Margin="4,0,0,0"/>
                                    <TextBlock VerticalAlignment="Center" Margin="10,0" FontSize="12" Foreground="{DynamicResource B.Text2}" Text="{Binding PageText}"/>
                                    <Button Style="{StaticResource Btn.Mini}" Content="&#xE76C;" FontFamily="{StaticResource F.Icon}" Command="{Binding NextCommand}"/>
                                    <Button Style="{StaticResource Btn.Mini}" Content="&#xE893;" FontFamily="{StaticResource F.Icon}" Command="{Binding LastCommand}" Margin="4,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ContentControl>

                    <!-- ขวา: แผนผัง + หลักฐาน -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <ContentControl Style="{StaticResource GlassCard}" Padding="14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{DynamicResource S.Js.Flow.Title}"/>
                                <ItemsControl ItemsSource="{Binding Flow}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <Border Width="2" HorizontalAlignment="Center" Background="{DynamicResource B.CyanSoftLine}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Margin" Value="0"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFirst}" Value="True"><Setter Property="Margin" Value="0,22,0,0"/></DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsLast}" Value="True"><Setter Property="Margin" Value="0,0,0,26"/></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Center" Margin="0,4"
                                                            Background="{StaticResource B.AquaGloss}" BorderBrush="{StaticResource B.GoldRing}" BorderThickness="1.5">
                                                        <TextBlock Style="{StaticResource T.Glyph}" Text="{Binding Glyph}" FontSize="15" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource B.Text}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Sub}" FontSize="11.5" Foreground="{DynamicResource B.Text2}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Margin="2,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource B.Text3}" Text="{Binding FlowNote}"/>
                            </StackPanel>
                        </ContentControl>
                        <ContentControl Grid.Row="1" Style="{StaticResource GlassCard}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource T.H2}" FontSize="15" Text="{DynamicResource S.Js.Ev.Title}"/>
                                <ScrollViewer Grid.Row="1" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Evidence}"/>
                                </ScrollViewer>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
