<UserControl x:Class="ReverseX.App.Views.MainShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ReverseX.App.ViewModels"
             xmlns:views="clr-namespace:ReverseX.App.Views"
             FontFamily="{StaticResource F.Ui}" FontSize="13"
             TextElement.Foreground="{DynamicResource B.Text}"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomePage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}"><views:PlaceholderPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:BinaryViewModel}"><views:BinaryPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JsViewModel}"><views:JsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiViewModel}"><views:AiPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:InsightViewModel}"><views:InsightPage/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:EvidenceViewModel}"><views:EvidencePage/></DataTemplate>

        <!-- ป้ายหลักฐาน: เห็นจริง / อนุมาน / ยังไม่รู้ -->
        <DataTemplate DataType="{x:Type vm:EvidenceRow}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding Badge}" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl" BasedOn="{StaticResource Chip.Green}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Level}" Value="Inferred"><Setter Property="Background" Value="{DynamicResource B.AmberSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.AmberSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.AmberText}"/></DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="Unknown"><Setter Property="Background" Value="{DynamicResource B.RedSoft}"/><Setter Property="BorderBrush" Value="{DynamicResource B.RedSoftLine}"/><Setter Property="Foreground" Value="{DynamicResource B.RedText}"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource B.Text}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root" Background="{DynamicResource B.Bg}">
        <Rectangle Fill="{DynamicResource B.WinImage}"/>
        <Rectangle Fill="{DynamicResource B.WinShade}"/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== title bar (ทำเอง) -->
            <Border Grid.Row="0" Background="{DynamicResource B.TitleFill}" BorderBrush="{DynamicResource B.GlassLine}" BorderThickness="0,0,0,1">
                <Grid Margin="12,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="/ReverseX;component/Assets/Logo/reversex-logo-256.png" Width="24" Height="24"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="10,0,12,0" VerticalAlignment="Center" FontFamily="{StaticResource F.Head}"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource B.Text}" TextTrimming="CharacterEllipsis"
                               Text="{DynamicResource S.App.Title}"/>

                    <!-- สลับภาษา -->
                    <Border Grid.Column="2" Margin="0,0,10,0" CornerRadius="12" Padding="2" Background="{DynamicResource B.GlassBtn}"
                            BorderBrush="{DynamicResource B.GlassLine}" BorderThickness="1" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="lang" Content="ไทย" Style="{StaticResource Seg}" IsChecked="{Binding IsThai, Mode=TwoWay}"/>
                            <RadioButton GroupName="lang" Content="EN" Style="{StaticResource Seg}" IsChecked="{Binding IsEnglish, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <!-- สลับธีม กลางคืน / ท้องฟ้า -->
                    <Border Grid.Column="3" Margin="0,0,12,0" CornerRadius="12" Padding="2" Background="{DynamicResource B.GlassBtn}"
                            BorderBrush="{DynamicResource B.GlassLine}" BorderThickness="1" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="theme" Content="{DynamicResource S.Theme.Night}" Style="{StaticResource Seg}" IsChecked="{Binding IsNight, Mode=TwoWay}"/>
                            <RadioButton GroupName="theme" Content="{DynamicResource S.Theme.Sky}" Style="{StaticResource Seg}" IsChecked="{Binding IsSky, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Btn.Win}" Content="&#xE921;" Click="OnMinimize"/>
                        <Button x:Name="MaxButton" Style="{StaticResource Btn.Win}" Content="&#xE922;" Click="OnMaximize"/>
                        <Button Style="{StaticResource Btn.WinClose}" Content="&#xE8BB;" Click="OnClose"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== เมนูซ้าย -->
                <Border Grid.Column="0" Margin="14,12,0,14" CornerRadius="22" Background="{DynamicResource B.SideFill}"
                        BorderBrush="{DynamicResource B.GlassLine}" BorderThickness="1.2" Effect="{StaticResource E.Card}">
                    <Grid Margin="12,14,12,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Image Source="/ReverseX;component/Assets/Logo/reversex-logo-512.png" Width="96" Height="96"
                                   Style="{StaticResource Icon3D}" Effect="{DynamicResource E.Logo}"/>
                            <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0" FontFamily="{StaticResource F.Head}" FontSize="27"
                                       FontWeight="Bold" FontStyle="Italic">
                                <Run Text="REVERSE" Foreground="{DynamicResource B.Wordmark}"/><Run Text=" X" Foreground="{DynamicResource B.WordmarkX}"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Gold}"
                                       Text="I&#8202;N&#8202;S&#8202;I&#8202;G&#8202;H&#8202;T &#160;S&#8202;T&#8202;U&#8202;D&#8202;I&#8202;O"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,6">
                            <ItemsControl ItemsSource="{Binding Nav}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="nav" Style="{StaticResource Nav}" Content="{Binding Title}" Tag="{Binding Icon}"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Border Grid.Row="2" BorderBrush="{DynamicResource B.Line}" BorderThickness="0,1,0,0" Padding="4,10,4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Style="{StaticResource StatusDot}" Tag="{Binding Home.ReaLevel}" VerticalAlignment="Top" Margin="0,4,8,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Home.ReaSideText}" TextWrapping="Wrap"/>
                                    <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource B.Text3}" TextWrapping="Wrap"
                                               Text="{DynamicResource S.Side.Local}"/>
                                    <TextBlock FontSize="11" Margin="0,4,0,0" FontWeight="Medium" Foreground="{DynamicResource B.Gold}" TextWrapping="Wrap"
                                               Text="{DynamicResource S.Side.Legal}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- ===== เนื้อหา -->
                <ContentControl Grid.Column="1" Content="{Binding Current}" Focusable="False" IsTabStop="False"/>
            </Grid>

            <!-- ===== ลงทะเบียนเครื่องก่อนใช้ (owner rule: ยังไม่ลงทะเบียน = ใช้อะไรไม่ได้) -->
            <Grid Grid.Row="1" x:Name="RegisterGate" Background="{DynamicResource B.Bg}" DataContext="{Binding License}"
                  Visibility="{Binding ShowGate, Converter={StaticResource B2V}}">
                <Rectangle Fill="{DynamicResource B.WinImage}"/>
                <Rectangle Fill="{DynamicResource B.WinShade}"/>
                <ContentControl Style="{StaticResource GlassCard}" Padding="30,24" MaxWidth="560" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <Image Source="/ReverseX;component/Assets/Logo/reversex-logo-512.png" Width="88" Height="88" Style="{StaticResource Icon3D}" HorizontalAlignment="Center"/>
                        <TextBlock Style="{StaticResource T.H2}" FontSize="20" Margin="0,12,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Text="{DynamicResource S.Gate.Title}"/>
                        <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource B.Text2}" Text="{DynamicResource S.Gate.Body}"/>
                        <TextBlock Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource B.Text}" Text="{Binding ReasonText}"/>
                        <Border Margin="0,10,0,0" CornerRadius="10" Padding="10,7" BorderThickness="1" Background="{DynamicResource B.AmberSoft}" BorderBrush="{DynamicResource B.AmberSoftLine}"
                                Visibility="{Binding HasNote, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding NoteText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" Foreground="{DynamicResource B.Text}"/>
                        </Border>
                        <TextBlock Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource B.CyanText}" Text="{Binding Notice}" Visibility="{Binding HasNotice, Converter={StaticResource B2V}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                            <Button Style="{StaticResource Btn.Aqua}" Margin="0,0,10,0" Content="{DynamicResource S.Gate.Retry}" Command="{Binding RefreshCommand}"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="{DynamicResource S.Gate.Exit}" Command="{Binding ExitCommand}"/>
                        </StackPanel>
                        <TextBlock Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource B.Text3}" Text="{DynamicResource S.Gate.Auto}"/>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
