<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>ReverseX</AssemblyName>
    <RootNamespace>ReverseX.App</RootNamespace>
    <ApplicationIcon>Assets\reversex.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\Logo\*.png" />
    <Resource Include="Assets\Icons3D\*.png" />
    <Resource Include="Assets\Backgrounds\*.png" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Fonts\OFL-*.txt" />
    <Resource Include="Assets\reversex.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReverseX.Core\ReverseX.Core.csproj" />
    <ProjectReference Include="..\ReverseX.Licensing\ReverseX.Licensing.csproj" />
  </ItemGroup>
</Project>
